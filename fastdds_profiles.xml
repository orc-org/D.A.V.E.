<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastrtps_profile">
    <!-- Transport definitions for high-throughput wireless links & video -->
    <transport_descriptors>
        <!-- UDPv4 with 1MB socket buffers for long-range antenna links -->
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>1048576</receiveBufferSize>
            <maxMessageSize>65500</maxMessageSize>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="rover_network_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>true</useBuiltinTransports>
            <builtin>
                <initialPeersList>
                    <!-- Localhost for Jetson internal communication -->
                    <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
                    <!-- Subnet broadcast for wireless antenna discovery, remove this if it breaks stuff idk -->
                    <locator><udpv4><address>255.255.255.255</address></udpv4></locator>
                </initialPeersList>
            </builtin>
        </rtps>
    </participant>
</profiles>
